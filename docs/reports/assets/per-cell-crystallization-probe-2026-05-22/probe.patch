+CA_FROZEN_THRESHOLD = 0.9          # hardness threshold for the frozen mask (measurement only)
+CA_FREEZE_FRACTION_STOP = 0.80     # early-exit when this fraction of cells exceeds CA_FROZEN_THRESHOLD
